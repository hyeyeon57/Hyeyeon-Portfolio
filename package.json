{
  "name": "hyeyeon-portfolio-admin",
  "version": "1.0.0",
  "private": true,
  "description": "백오피스 관리 시스템",
  "scripts": {
    "clean": "rimraf .next",
    "clean:force": "node -e \"const fs=require('fs');const path=require('path');function rm(p){try{if(fs.existsSync(p)){fs.readdirSync(p).forEach(f=>{const cur=path.join(p,f);if(fs.lstatSync(cur).isDirectory())rm(cur);else fs.unlinkSync(cur);});fs.rmdirSync(p);}}catch(e){}}\" && rimraf .next",
    "dev": "npm run clean && next dev",
    "dev:fresh": "npm run clean && next dev",
    "dev:server": "npm run build:admin-css && node server/index.cjs",
    "build": "npm run build:admin-css || echo 'Warning: admin-css build failed, continuing...' && next build",
    "build:admin-css": "tailwindcss -i ./server/admin/admin.css -o ./public/admin.css --minify -c ./tailwind.admin.config.ts",
    "start": "next start",
    "start:server": "node server/index.cjs",
    "migrate": "node server/migrate.cjs",
    "migrate:static": "node server/migrate-from-static.cjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.757.0",
    "@aws-sdk/s3-request-presigner": "^3.943.0",
    "@emailjs/browser": "^4.4.1",
    "@vercel/blob": "^1.1.1",
    "@vercel/speed-insights": "^1.2.0",
    "clsx": "^2.1.1",
    "connect-mongo": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-session": "^1.18.2",
    "framer-motion": "^12.23.24",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.545.0",
    "memorystore": "^1.6.7",
    "mongoose": "^8.19.3",
    "multer": "^2.0.2",
    "next": "14.2.33",
    "react": "^18",
    "react-dom": "^18",
    "resend": "^6.1.3",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/multer": "^2.0.0",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.33",
    "postcss": "^8",
    "rimraf": "^5.0.0",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "overrides": {
    "rimraf": "^5.0.0",
    "glob": "^10.0.0"
  }
}
