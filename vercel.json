{
  "version": 2,
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nextjs",
  "outputDirectory": ".next",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "pages/api/**/*.ts": {
      "memory": 3008,
      "maxDuration": 60,
      "includeFiles": "server/**"
    },
    "api/**/*.js": {
      "memory": 1024,
      "maxDuration": 60,
      "includeFiles": "server/**"
    }
  }
}

